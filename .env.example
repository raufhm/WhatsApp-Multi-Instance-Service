# Example environment variables for local Docker usage.
# Copy to .env and adjust as needed.

# PostgreSQL
PG_DSN=postgres://whatsapp:whatsapp@db:5432/whatsapp?sslmode=disable

# HTTP server
PORT=8080

# Logging
LOG_LEVEL=INFO

# Bot configuration
BOT_SESSION_TIMEOUT=30m
BOT_FALLBACK_REPLY=I'm sorry, I didn't understand that.
BOT_RULES_VERSION=default

# Optional S3 media uploads (leave S3_BUCKET empty to disable)
S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Upload worker
UPLOAD_WORKER_ENABLED=true
UPLOAD_POLL_INTERVAL=5s
UPLOAD_MAX_ATTEMPTS=5
UPLOAD_INITIAL_BACKOFF=1s
UPLOAD_MAX_BACKOFF=60s
UPLOAD_LEASE=60s
UPLOAD_JITTER=0.2
