# Example environment variables for local Docker usage.
# Copy to .env and adjust as needed.

# PostgreSQL / Neon (used by the app)
# For local docker compose, set APP_ENV=dev in compose and provide your Neon DSN here.
# For production, APP_ENV should not be "dev"; apply migrations with the self-hosted deployment process.
PG_DSN=

# HTTP server
PORT=8080

# Logging
LOG_LEVEL=INFO

# Bot configuration
BOT_SESSION_TIMEOUT=30m
BOT_FALLBACK_REPLY=
BOT_RULES_VERSION=default

# Optional S3-compatible media storage (leave S3_BUCKET empty to use local disk)
# Cloudflare R2 example:
# S3_BUCKET=your-bucket
# S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_OBJECT_URL=https://pub-your-account-id.r2.dev
# AWS_ACCESS_KEY_ID=your-r2-access-key
# AWS_SECRET_ACCESS_KEY=your-r2-secret-key
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_OBJECT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Upload worker
UPLOAD_WORKER_ENABLED=true
UPLOAD_POLL_INTERVAL=5s
UPLOAD_MAX_ATTEMPTS=5
UPLOAD_INITIAL_BACKOFF=1s
UPLOAD_MAX_BACKOFF=60s
UPLOAD_LEASE=60s
UPLOAD_JITTER=0.2
